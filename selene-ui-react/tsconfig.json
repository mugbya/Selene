{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
//    "moduleResolution": "Node",
          "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    //      "baseUrl": ".",
    "baseUrl": "./src",           // 推荐
    "paths": {
      //        "@/*": ["src/*"],
      "@/*": ["*"]
    }
  },
  "esModuleInterop": true,
  "forceConsistentCasingInFileNames": true,
  "skipLibCheck": true,
  "include": ["src"]
}

